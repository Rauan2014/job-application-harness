# --- Provedor LLM (Google AI Studio / Gemini) ---
# Obtenha sua chave gratuita em: https://aistudio.google.com/app/apikey
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash

# (Caso prefira usar OpenAI):
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# --- Google Sheets (Planilha Central de Vagas) ---
# Se a planilha estiver no Google Sheets, cole a URL completa ou o ID dela aqui:
# Exemplo: https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms/edit
# Dica de Ouro: Se a planilha estiver compartilhada como "Qualquer pessoa com o link" (Leitor),
# o harness baixa ela diretamente todo dia sem precisar de nenhuma credencial do Google Cloud!
GOOGLE_SHEET_URL=
INCLUDE_BLANK_STATUS=true

# --- Google Drive (Currículos) ---
# ID da pasta do Drive contendo os currículos (o hash no final da URL da pasta)
DRIVE_FOLDER_ID=

# IMPORTANTE sobre o Drive / Arquivos Privados:
# Chave de API simples NÃO serve para acessar pastas privadas no Google Drive.
# Se for sincronizar currículos do Drive automaticamente, você tem duas opções:
# Opção A: OAuth Desktop (client_secret.json) - Recomendado para contas normais/empresariais.
# Opção B: Service Account (service_account.json) - Para projetos pessoais no Google Cloud.
# Opção C (Zero Cloud): Baixe os PDFs dos currículos diretamente para a pasta cache/resumes/
GOOGLE_OAUTH_CLIENT_FILE=./client_secret.json
GOOGLE_SERVICE_ACCOUNT_FILE=./service_account.json
MAX_CONCURRENCY=3
# Seguro por padrão: nada é enviado sem DRY_RUN=false explícito (ou --no-dry-run)
DRY_RUN=true
HEADLESS=true
CACHE_DIR=./cache/resumes
SCREENSHOT_DIR=./artifacts/screenshots
RESULTS_FILE=./artifacts/results.jsonl
SHEET_RESULT_FILE=./artifacts/planilha_atualizada.xlsx
TASK_TIMEOUT_S=120
NAV_TIMEOUT_MS=30000
ACTION_TIMEOUT_MS=10000
MAX_RETRIES=2
BACKOFF_BASE_S=1.0
# JSON list de padrões glob (fnmatch) de URL a bloquear
BLOCKED_URL_PATTERNS=["*google-analytics.com*","*googletagmanager.com*","*doubleclick.net*","*facebook.net*","*hotjar.com*","*segment.io*"]

# --- LLM ---
LLM_MAX_RETRIES=3
LLM_TIMEOUT_S=60
LLM_MAX_INPUT_CHARS=12000

# --- Planilha e currículo ---
MIN_FIT_SCORE=70
FIT_GATE_ENABLED=true
RESUME_MATCH_THRESHOLD=0.9

# --- Decisão (Laya) ---
DECISION_BACKEND=laya
LAYA_URL=http://127.0.0.1:8787
LAYA_TIMEOUT_S=5.0
LAYA_CPU_TIMEOUT_FACTOR=5
LAYA_MAX_FAILURES=3
LAYA_YES_THRESHOLD=0.8
LAYA_NO_THRESHOLD=0.2
LAYA_MIN_MARGIN=0.15
LAYA_ORDER_SWAP=true
LAYA_STATE_MAX_CHARS=1500
LAYA_PLAN_ABOVE_CHARS=600
LAYA_DP_MODES={"DP1":"shadow","DP2":"shadow","DP3":"active","DP4":"active","DP5":"shadow","DP6":"active"}
LAYA_REQUIRE_EVAL_FOR_ACTIVE=true
LAYA_EVAL_FILE=./artifacts/laya_eval.json
LAYA_EVAL_MAX_AGE_DAYS=14
EVAL_MIN_EXAMPLES=30
EVAL_MARGIN=0.10
DECISION_AUDIT_FILE=./artifacts/decisions.jsonl
