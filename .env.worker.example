# ==============================================================================
# CANDIDATA CLOUD — VARIÁVEIS DE PRODUÇÃO DO WORKER (VPS HETZNER)
# Copie este arquivo para .env na raiz do ia_candidata antes de subir o Docker.
# ==============================================================================

# --- Identificação do Worker ---
WORKER_ID=hetzner-cpx21-01
POLL_INTERVAL_S=5.0

# --- Supabase (Backend da Candidata Cloud) ---
# Encontrado em: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://seu-projeto.supabase.co
# ATENÇÃO: Use a chave 'service_role' secreta, NUNCA a chave 'anon' pública!
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_aqui

# --- Provedor LLM (Google AI Studio / Gemini 2.5 Flash) ---
# Obtenha sua chave gratuita em: https://aistudio.google.com/app/apikey
LLM_API_KEY=sua_chave_gemini_aqui
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash

# --- Configurações do Navegador & Camoufox Anti-Detect ---
HEADLESS=true
USE_CAMOUFOX=true
MAX_CONCURRENCY=3

# --- Timeouts e Tolerâncias ---
TASK_TIMEOUT_S=120
NAV_TIMEOUT_MS=30000
ACTION_TIMEOUT_MS=10000
MAX_RETRIES=2
BACKOFF_BASE_S=1.0

# --- Diretórios Locais ---
CACHE_DIR=./cache/resumes
SCREENSHOT_DIR=./artifacts/screenshots

# --- Flags de Compatibilidade ---
DRIVE_FOLDER_ID=none
INCLUDE_BLANK_STATUS=true
MIN_FIT_SCORE=70
DECISION_BACKEND=rules
